{
  "name": "ts-school",
  "version": "0.1.0",
  "description": "TypeScript School — a static Vue 3 + vite-ssg site whose lessons pair fragile JavaScript with the TypeScript that fixes it, with diagnostics checked at build time against the Strada compiler API",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/generate-diagnostics.mjs && node scripts/generate-search-index.mjs --skip-vectors && node scripts/check-local-models.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-diagnostics.mjs && node scripts/generate-search-index.mjs",
    "build": "vite-ssg build",
    "preview": "vite preview --port 8787 --host",
    "lint": "node scripts/eslint-strada.mjs .",
    "lint:fix": "node scripts/eslint-strada.mjs . --fix",
    "stylelint": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "typecheck": "node scripts/vue-tsc-strada.mjs --noEmit",
    "pretest": "node scripts/generate-diagnostics.mjs --check && node scripts/generate-search-index.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project='Chromium Desktop'",
    "test:e2e:mobile": "playwright test --project='Chromium Mobile' tests/e2e/responsive.spec.ts",
    "test:e2e:full": "playwright test",
    "test:e2e:llm": "TS_SCHOOL_LLM_E2E=1 playwright test --workers=1 --project='Chromium Desktop' tests/e2e/ai-chat-markdown.spec.ts",
    "gate:release": "pnpm run lint && pnpm run stylelint && pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:e2e && pnpm run test:e2e:mobile",
    "models:compare": "node --experimental-strip-types scripts/school-model-compare.mjs --fixtures",
    "models:compare:live": "node --experimental-strip-types scripts/school-model-compare.mjs --live",
    "generate:diagnostics": "node scripts/generate-diagnostics.mjs",
    "generate:search-index": "node scripts/generate-search-index.mjs",
    "models:fetch": "node scripts/fetch-ai-models.mjs"
  },
  "dependencies": {
    "@litert-lm/core": "0.15.0",
    "@unhead/vue": "3.3.1",
    "@vanduo-oss/vd3": "1.2.2",
    "@vanduo-oss/vd3-cbun": "1.3.1",
    "@vanduo-oss/vdl-ai-chat": "^0.1.0",
    "@vanduo-oss/vdl-hybrid-search": "^0.1.1",
    "fuse.js": "7.3.0",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "3.8.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "4.13.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "typescript-strada": "npm:typescript@6.0.3",
    "vite": "^8.2.1",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.18.0"
}
